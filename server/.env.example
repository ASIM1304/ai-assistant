NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ai_interview
# openssl rand -hex 48   (>= 32 chars; the server refuses to start otherwise)
JWT_SECRET=
# Exact frontend origin(s), comma-separated. Never "*". https:// in production.
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# "none" only if frontend and API are on different sites (requires https)
COOKIE_SAMESITE=lax
TRUST_PROXY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Production: verification is on by default and needs SMTP
REQUIRE_EMAIL_VERIFICATION=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AI Interview <no-reply@yourdomain.com>"
PRIVACY_CONTACT_EMAIL=privacy@yourdomain.com
